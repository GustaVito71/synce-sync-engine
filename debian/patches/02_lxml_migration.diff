diff -urN a/tests/testutil.py b/tests/testutil.py
--- a/tests/testutil.py	1969-12-31 21:00:00.000000000 -0300
+++ b/tests/testutil.py	2026-03-08 13:07:14.714027600 -0300
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""Shared helpers for SyncEngine XML test suite."""
+
+from lxml import etree
+
+
+def _local_name(tag):
+    """Strip namespace from Clark-notation tag."""
+    if isinstance(tag, str) and '}' in tag:
+        return tag.split('}', 1)[1]
+    return tag if isinstance(tag, str) else ""
+
+
+def elements_equal(e1, e2, path=""):
+    """
+    Deep structural comparison of two lxml Elements.
+    Returns None if equal, or a descriptive error string if not.
+    Ignores namespace prefixes; strips whitespace in text; compares
+    non-namespaced attributes only.
+    """
+    n1 = _local_name(e1.tag)
+    n2 = _local_name(e2.tag)
+    here = "%s/%s" % (path, n1) if path else ("/" + n1)
+
+    if n1 != n2:
+        return "tag mismatch at %s: %r vs %r" % (path or "/", n1, n2)
+
+    t1 = (e1.text or "").strip()
+    t2 = (e2.text or "").strip()
+    if t1 != t2:
+        return "text mismatch at %s: %r vs %r" % (here, t1, t2)
+
+    # Compare non-namespaced attributes (e.g. Value="DATE-TIME")
+    a1 = {k: v for k, v in e1.attrib.items() if not k.startswith('{')}
+    a2 = {k: v for k, v in e2.attrib.items() if not k.startswith('{')}
+    if a1 != a2:
+        return "attribute mismatch at %s: %r vs %r" % (here, a1, a2)
+
+    c1 = [c for c in e1 if isinstance(c.tag, str)]
+    c2 = [c for c in e2 if isinstance(c.tag, str)]
+    if len(c1) != len(c2):
+        return "child count mismatch at %s: %d vs %d" % (here, len(c1), len(c2))
+
+    for ch1, ch2 in zip(c1, c2):
+        err = elements_equal(ch1, ch2, here)
+        if err:
+            return err
+
+    return None
+
+
+def assert_xml_equal(testcase, result_tree, reference_file):
+    """
+    Assert that an XSLT result tree matches a reference XML file structurally.
+    Prints a diff on failure.
+    """
+    result_root = result_tree.getroot()
+    reference_root = etree.parse(reference_file).getroot()
+    err = elements_equal(result_root, reference_root)
+    if err:
+        print("RESULT:\n" + etree.tostring(result_root, encoding="unicode", pretty_print=True))
+        print("REFERENCE:\n" + etree.tostring(reference_root, encoding="unicode", pretty_print=True))
+    testcase.assertIsNone(err, err)
