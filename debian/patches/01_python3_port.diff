+            if enddate.year > self.starttime.year:
+                if initdate.year == self.starttime.year:
+                    enddate = datetime.datetime(year+1,1,1,0,0,0)
+                else:
+                    # the year week is invalid, so ignore.
+                    
+                    continue
+        
+            isect=self.Intersect(TimeSpan(initdate,enddate))
+            
+            if isect != None:
+                rlist.append(isect)
