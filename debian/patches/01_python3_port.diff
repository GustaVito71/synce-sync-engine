+            else:
+                end = datetime.datetime(self.starttime.year,mrule+1,1,0,0,0)
+            
+            isect = self.Intersect(TimeSpan(start,end))
+            
+            if isect!=None:
+                rlist.append(isect)
+            
+        # no need to sort here if rules were pre-sorted
+            
+        return rlist
