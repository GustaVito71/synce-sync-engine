diff -urN a/tests/test_air2os_30.py b/tests/test_air2os_30.py
--- a/tests/test_air2os_30.py	1969-12-31 21:00:00.000000000 -0300
+++ b/tests/test_air2os_30.py	2026-03-08 14:04:17.728336000 -0300
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+Tests for AirSync → OpenSync 3.x (OS30) format conversion.
+Uses SyncEngine/formats30/ parsers and XSL stylesheets.
+"""
+
+import sys
+import logging
+import os
+import unittest
+sys.path.insert(0, "..")
+
+from lxml import etree
+
+from SyncEngine import formats30      # noqa: F401  (registers OS30 parser)
+from SyncEngine import constants
+from SyncEngine import formatapi
+from testutil import assert_xml_equal
+
+
+logging.basicConfig(level=logging.DEBUG,
+                    stream=sys.stdout,
+                    format='%(asctime)s %(levelname)s %(name)s : %(message)s')
+
+
+class Air2OS30(unittest.TestCase):
+
+    def setUp(self):
+        self.testdatadir = os.path.join(os.path.dirname(__file__),
+                                        "testdata", "air2os_30")
+
+    def _compare_files(self, suffix):
+        """Convert airsync_<suffix>.xml DIR_FROM_AIRSYNC (OS30) and compare to opensync_<suffix>.xml."""
+        src_file = os.path.join(self.testdatadir, "airsync_%s.xml" % suffix)
+        name = os.path.basename(src_file)[len("airsync_"):]
+        if name.startswith("contact_"):
+            itemtype = constants.SYNC_ITEM_CONTACTS
+        elif name.startswith("event_"):
+            itemtype = constants.SYNC_ITEM_CALENDAR
+        elif name.startswith("task_"):
+            itemtype = constants.SYNC_ITEM_TASKS
+        else:
+            self.fail("Unknown item type for suffix %r" % suffix)
+
+        src = etree.parse(src_file)
+        dst = formatapi.ConvertFormat(constants.DIR_FROM_AIRSYNC,
+                                      itemtype, src, "OS30")
+        reference_file = os.path.join(self.testdatadir,
+                                      "opensync_%s.xml" % suffix)
+        assert_xml_equal(self, dst, reference_file)
+
+    # --- Tasks ---
+
+    def test_task_simple(self):
+        """Simple task: Subject, Complete=0, Sensitivity, Importance."""
+        return self._compare_files("task_simple")
+
+    def test_task_complete(self):
+        """Complete=1 → Status/COMPLETED + PercentComplete/100."""
+        return self._compare_files("task_complete")
+
+    def test_task_dates(self):
+        """DueDate+UtcDueDate+StartDate+UtcStartDate → Due/Content (UTC) + DateStarted/Content.
+        Exercises _DateFromAirsyncExt: no current TZ → reads Utc* sibling."""
+        return self._compare_files("task_dates")
+
+    # --- Contacts ---
+
+    def test_contact_simple(self):
+        """Contact with FileAs/FirstName/LastName/Birthday → FormattedName/FileAs/Name/Birthday."""
+        return self._compare_files("contact_simple")
+
+    # --- Events ---
+
+    def test_event_simple(self):
+        """Simple event: Subject, StartTime, EndTime, BusyStatus, Sensitivity.
+        Validates @Value='DATE-TIME' on DateStarted/DateEnd."""
+        return self._compare_files("event_simple")
+
+    def test_event_recurrence(self):
+        """Weekly recurrence: Type=1/DayOfWeek=2/Interval=1 → Frequency=WEEKLY/ByDay=MO."""
+        return self._compare_files("event_recurrence")
+
+    def test_event_timezone_attributes(self):
+        """Timezone blob in input → @TimezoneID present and non-empty on DateStarted/DateEnd."""
+        from SyncEngine.formats30 import tzdatabase
+        tzdatabase.tzdb = tzdatabase.TZDatabase()  # reset global state
+        src_file = os.path.join(os.path.dirname(__file__),
+                                "testdata", "air2os", "airsync_event_ex1.xml")
+        src = etree.parse(src_file)
+        dst = formatapi.ConvertFormat(constants.DIR_FROM_AIRSYNC,
+                                      constants.SYNC_ITEM_CALENDAR, src, "OS30")
+        root = dst.getroot()
+        for tag in ("DateStarted", "DateEnd"):
+            nodes = root.xpath("//*[local-name()='%s']" % tag)
+            self.assertTrue(nodes, "%s not found in output" % tag)
+            tzid = nodes[0].get("TimezoneID")
+            self.assertIsNotNone(tzid, "@TimezoneID missing on %s" % tag)
+            self.assertTrue(len(tzid) > 0, "@TimezoneID empty on %s" % tag)
+
+
+if __name__ == '__main__':
+    unittest.main()
