@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+Tests for OpenSync 3.x (OS30) → AirSync format conversion.
+Uses SyncEngine/formats30/ parsers and XSL stylesheets.
+"""
+
+import sys
+import logging
+import os
+import unittest
+sys.path.insert(0, "..")
+
+from lxml import etree
+
+from SyncEngine import formats30      # noqa: F401  (registers OS30 parser)
+from SyncEngine import constants
+from SyncEngine import formatapi
+from testutil import assert_xml_equal
+
+
+logging.basicConfig(level=logging.DEBUG,
+                    stream=sys.stdout,
+                    format='%(asctime)s %(levelname)s %(name)s : %(message)s')
+
+
+class OS2Air30(unittest.TestCase):
+
+    def setUp(self):
+        self.testdatadir = os.path.join(os.path.dirname(__file__),
+                                        "testdata", "os2air_30")
+
+    def _compare_files(self, suffix):
+        """Convert opensync_<suffix>.xml DIR_TO_AIRSYNC (OS30) and compare to airsync_<suffix>.xml."""
+        src_file = os.path.join(self.testdatadir, "opensync_%s.xml" % suffix)
+        name = os.path.basename(src_file)[len("opensync_"):]
+        if name.startswith("contact_"):
+            itemtype = constants.SYNC_ITEM_CONTACTS
+        elif name.startswith("event_"):
+            itemtype = constants.SYNC_ITEM_CALENDAR
+        elif name.startswith("task_"):
+            itemtype = constants.SYNC_ITEM_TASKS
+        else:
+            self.fail("Unknown item type for suffix %r" % suffix)
+
+        src = etree.parse(src_file)
+        dst = formatapi.ConvertFormat(constants.DIR_TO_AIRSYNC,
+                                      itemtype, src, "OS30")
+        reference_file = os.path.join(self.testdatadir,
+                                      "airsync_%s.xml" % suffix)
+        assert_xml_equal(self, dst, reference_file)
+
+    # --- Tasks ---
+
+    def test_task_simple(self):
+        """Simple task with Status/Priority/Class → Complete/Importance/Sensitivity/Subject."""
+        return self._compare_files("task_simple")
+
+    def test_task_dates(self):
+        """Due/DateStarted → DueDate+UtcDueDate+StartDate+UtcStartDate.
+        Exercises _DateToAirsyncLocal and _DateToAirsyncUTC (no TZ → both equal UTC)."""
+        return self._compare_files("task_dates")
+
+    # --- Events ---
+
+    def test_event_simple(self):
+        """Simple timed event with LastModified → DtStamp, @Value='DATE-TIME' validated."""
+        return self._compare_files("event_simple")
+
+    def test_event_allday(self):
+        """@Value='DATE' on DateStarted/DateEnd → AllDayEvent=1, times at midnight UTC.
+        Exercises the XSL: <xsl:when test=\"@Value = 'DATE'\">1</xsl:when> branch."""
+        return self._compare_files("event_allday")
+
+    def test_event_recurrence(self):
+        """Weekly recurrence: Frequency=WEEKLY/ByDay=MO/Interval=1 → Type=1/DayOfWeek=2."""
+        return self._compare_files("event_recurrence")
+
+    # --- Contacts ---
+
+    def test_contact_simple(self):
+        """Contact with FileAs/Name/Birthday → C1:FileAs/C1:FirstName/C1:LastName/C1:Birthday."""
+        return self._compare_files("contact_simple")
+
+
+if __name__ == '__main__':
+    unittest.main()
